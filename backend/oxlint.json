{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_linter/src/rules.rs",
  "ignorePatterns": [
    "src/generated/**"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-floating-promises": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@prisma/*",
              "**/generated/prisma/**"
            ],
            "message": "Prisma chỉ được dùng trong src/prisma/ và **/infrastructure/**"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/prisma/**",
        "src/**/infrastructure/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/**/domain/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/*",
                  "@prisma/*",
                  "**/generated/prisma/**",
                  "express",
                  "class-validator",
                  "class-transformer"
                ],
                "message": "domain là TypeScript thuần: không phụ thuộc framework, ORM hay HTTP"
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "node": true
  }
}
